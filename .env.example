# ==============================================================================
# ATFAR - Portal de Gestión Sindical y Farmacias
# Archivo de ejemplo de Variables de Entorno
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Base de datos PostgreSQL, Auth & Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key

# URL pública de la aplicación (usada para callbacks de pago y redirecciones)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Plus Pagos / Nuevo Banco de Santa Fe (Administradora San Juan S.A.)
# ------------------------------------------------------------------------------
# Activar la pestaña y botón de "Pago Online" en el portal de farmacias (por defecto: false)
NEXT_PUBLIC_PLUS_PAGOS_ENABLED=false

# Credenciales de producción provistas por Administradora San Juan S.A. / Plus Pagos:
# PLUS_PAGOS_API_URL=https://botonpp.asjservicios.com.ar/          # POST del formulario del botón
# PLUS_PAGOS_API_BASE=https://botonpp.asjservicios.com.ar:8082/    # API de consulta de transacciones
# PLUS_PAGOS_MERCHANT_ID=tu-identificador-de-comercio-guid
# PLUS_PAGOS_SECRET_KEY=tu-secret-key-provista-por-el-banco        # cifra el formulario + hash
# PLUS_PAGOS_PHRASE=tu-frase-base64                                # autenticación en la API de consultas
# PLUS_PAGOS_FORM_KEY_SOURCE=secret_key                            # 'secret_key' (oficial) o 'phrase'

# Secreto para el control diario de pagos (Vercel Cron lo manda como Bearer).
# CRON_SECRET=un-texto-largo-y-aleatorio

