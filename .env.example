# ==============================================================================
# ATFAR - Portal de Gestión Sindical y Farmacias
# Archivo de ejemplo de Variables de Entorno
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Base de datos PostgreSQL, Auth & Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key

# URL pública de la aplicación (usada para callbacks de pago y redirecciones)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Plus Pagos / Nuevo Banco de Santa Fe (Administradora San Juan S.A.)
# ------------------------------------------------------------------------------
# Activar la pestaña y botón de "Pago Online" en el portal de farmacias (por defecto: false)
NEXT_PUBLIC_PLUS_PAGOS_ENABLED=false

# Para pruebas locales o sandbox:
# PLUS_PAGOS_SANDBOX=true

# Credenciales de producción provistas por Administradora San Juan S.A.:
# PLUS_PAGOS_API_URL=https://api.pluspagos.com/v1
# PLUS_PAGOS_API_KEY=tu-api-key-provista-por-el-banco
# PLUS_PAGOS_MERCHANT_ID=tu-codigo-de-comercio-atfar
# PLUS_PAGOS_WEBHOOK_SECRET=tu-clave-secreta-para-validar-firma-webhook

